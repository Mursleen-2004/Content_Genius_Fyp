# Copy to .env for local dev. On Vercel, set these in
# Project Settings -> Environment Variables (Production + Preview).

# Local only. Vercel assigns the port itself.
PORT=4000

# MongoDB Atlas connection string.
# Atlas Network Access must allow 0.0.0.0/0 — Vercel functions have no static IP.
MONGO_URI=

# Any long random string. Use a NEW value in production, not the local one.
JWT_SECRET=

# Comma-separated frontend origins allowed through CORS.
# Set this to your deployed client URL, e.g. https://content-genius.vercel.app
CLIENT_URL=http://localhost:5173

# Third-party API keys
RAPIDAPI_KEY=

GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=




